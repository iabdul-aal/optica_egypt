{
  "name": "optica-egypt",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-site.mjs",
    "check": "npm run lint && npm run typecheck && npm run validate",
    "test": "playwright test --reporter=list",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:live": "node --env-file=.env.local node_modules/@playwright/test/cli.js test e2e/recruitment.spec.ts e2e/passwords.spec.ts --workers=1"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.10",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "source-map-js": "^1.2.2"
  }
}
