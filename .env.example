# Chapter recruitment. Copy to .env.local or configure in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://optica-egypt.com
# Optional Google Search Console HTML meta tag token (when not verifying via DNS TXT).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional cross-origin Vercel API base URL for static GitHub Pages mirror builds.
NEXT_PUBLIC_API_BASE_URL=
ALLOWED_PUBLIC_ORIGINS=https://iabdul-aal.me
